# MCP Server Configuration
# Copy this file to .env and fill in your values

# Exa AI Configuration
EXA_API_KEY=your_exa_api_key_here

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# MCP Server URLs (if using remote servers)
DOCFORK_MCP_URL=http://localhost:3001
EXA_URL=http://localhost:3002
NEO4J_MEMORY_URL=http://localhost:3003
SEQUENTIAL_THINKING_URL=http://localhost:3004
CLEAR_THOUGHT_URL=http://localhost:3005

# Default timeout and retries
MCP_TIMEOUT=30000
MCP_RETRIES=3
