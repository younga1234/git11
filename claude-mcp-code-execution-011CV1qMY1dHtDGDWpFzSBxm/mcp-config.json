{
  "mcpServers": {
    "docfork-mcp": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "docfork-mcp"],
      "env": {},
      "description": "Document forking and management capabilities"
    },
    "exa": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-exa"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "description": "Advanced web search powered by Exa AI"
    },
    "neo4j-memory": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "knowall-ai-mcp-neo-4-j-agent-memory"],
      "env": {
        "NEO4J_URI": "${NEO4J_URI:-bolt://localhost:7687}",
        "NEO4J_USER": "${NEO4J_USER:-neo4j}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}"
      },
      "description": "Agent memory storage using Neo4j graph database"
    },
    "sequential-thinking": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "smithery-ai-server-sequential-thinking"],
      "env": {},
      "description": "Sequential thinking and reasoning capabilities"
    },
    "clear-thought": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "waldzellai-clear-thought"],
      "env": {},
      "description": "Clear thought process and structured reasoning"
    }
  },
  "defaults": {
    "timeout": 30000,
    "retries": 3,
    "enablePIIProtection": true
  }
}
